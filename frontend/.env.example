# Usually you need NOTHING here.
#
# `bun run dev:web` proxies /api to 127.0.0.1:3014 (see vite.config.ts), so the
# SPA and API share one origin in development exactly as they do in production.
# That matters: the session cookie is SameSite=Lax and a browser will not send it
# on a cross-origin request.
#
# Only set this to call an API on another origin, and expect to be signed out --
# there is no token to fall back on any more.
# VITE_API_URL=http://localhost:3014
